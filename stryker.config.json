{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vite.config.ts"
  },
  "runner": "inPro",
  "ignorePatterns": ["src-tauri/target", "reports", "dist", "stryker-tmp", ".stryker-tmp"],
  "cleanTempDir": true,
  "mutate": [
    "src/**/*.{ts,tsx}",
    "!src/main.tsx",
    "!src/types.ts",
    "!src/**/*.test.{ts,tsx}",
    "!src/test/**"
  ],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "reporters": ["html", "clear-text", "progress"],
  "html": { "fileName": "reports/mutation/mutation.html" }
}
